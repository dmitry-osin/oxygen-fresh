# Example Nginx reverse proxy for the blog (ai/requirements.md 46-51).
# TLS via Let's Encrypt (certbot), user uploads served straight from
# the mounted volume, everything else proxied to the app on :8000.

server {
    listen 80;
    listen [::]:80;
    server_name blog.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name blog.example.com;

    ssl_certificate     /etc/letsencrypt/live/blog.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blog.example.com/privkey.pem;

    gzip on;
    gzip_types text/html text/css application/json application/xml image/svg+xml;

    # Uploaded media: served directly by Nginx from the Docker volume,
    # bypassing the app. Point this at the host side of the volume.
    location /uploads/ {
        alias /srv/oxygen-blog/static/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Everything else goes to the app.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Certbot renewal (optional, standard):
# certbot certonly --webroot -w /var/www/certbot -d blog.example.com
