# ── Required ──────────────────────────────────────────────────────────────

# Bcrypt hash of the admin password.
# Keep the single quotes: bcrypt hashes contain $ which the loader would
# otherwise expand as an environment variable reference.
# Generate: deno eval 'import bcrypt from "npm:bcryptjs"; console.log(bcrypt.hashSync("your-password", 10))'
ADMIN_PASSWORD_HASH='bcrypt-hash-goes-here'

# Random string for cookie signing (min 32 chars). Keep set in deployments.
SESSION_SECRET=

# Public origin of the site (no trailing slash), e.g. https://blog.example.com
SITE_URL=

# ── Runtime (optional) ────────────────────────────────────────────────────

# HTTP port for `deno task start` (default 8000). Vite dev uses 5173.
PORT=8000

# Deno KV SQLite file
KV_PATH=./data/kv.sqlite3

# Uploaded media directory (served via /uploads/…)
UPLOAD_DIR=./static/uploads

# ── First-run site settings (optional) ────────────────────────────────────
# Written to KV only when ["settings"] is empty. Later edits in Admin →
# Settings win; changing these env vars will NOT overwrite existing KV data.

SITE_NAME=oxygen-blog
SITE_DESCRIPTION=
FOOTER_DESCRIPTION=
# light | dark | system
THEME=system
POSTS_PER_PAGE=10
DEFAULT_META_TITLE=
DEFAULT_META_DESCRIPTION=

# Giscus (GitHub Discussions comments) — seed only
GISCUS_ENABLED=false
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=
# pathname | url | title
GISCUS_MAPPING=pathname
GISCUS_LANG=ru

# Public /contact form — seed only
CONTACT_FORM_ENABLED=false
CONTACT_FORM_LABEL=Contact
CONTACT_FORM_MENU_ORDER=99
CONTACT_FORM_INTRO=
CONTACT_CAPTCHA_ENABLED=true

# ── First-run admin profile (optional) ────────────────────────────────────
# Applied only when the admin user is created (username is always "admin").

ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
ADMIN_BIO=
ADMIN_EMAIL=
ADMIN_LOCATION=
ADMIN_WEBSITE=
