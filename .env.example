# Required: bcrypt hash of the admin password
ADMIN_PASSWORD_HASH=

# Required: random string for cookie signing (min 32 chars)
SESSION_SECRET=

# Optional: defaults to 8000
PORT=8000

# Optional: defaults to ./data/kv.sqlite3
KV_PATH=./data/kv.sqlite3

# Optional: defaults to ./static/uploads
UPLOAD_DIR=./static/uploads

# Required: public URL, e.g. https://blog.example.com
SITE_URL=
